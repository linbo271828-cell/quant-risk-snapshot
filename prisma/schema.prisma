generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Portfolio {
  id                    String     @id @default(cuid())
  userId                String     // GitHub (or other provider) user id; portfolios are private per user
  name                  String
  mode                  String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  defaultsRange         String     @default("1y")
  defaultsBenchmark     String     @default("SPY")
  defaultsRiskFreeRate  Float      @default(0)
  defaultsShrinkage     Boolean    @default(false)
  holdings              Holding[]
  snapshots             Snapshot[]
  alertRules            AlertRule[]
  detectiveReports      DetectiveReport[]
  events                Event[]
  backtestRuns          BacktestRun[]

  @@index([userId])
}

model Holding {
  id          String    @id @default(cuid())
  portfolioId String
  ticker      String
  value       Float
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Snapshot {
  id             String    @id @default(cuid())
  portfolioId    String
  createdAt      DateTime  @default(now())
  range          String
  benchmark      String
  riskFreeRate   Float
  shrinkage      Boolean
  metricsJson    Json
  seriesJson     Json
  riskJson       Json
  holdingsJson   Json
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
}

model AlertRule {
  id          String    @id @default(cuid())
  portfolioId String
  type        String
  threshold   Float
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, type])
}

enum EventType {
  SEC_FILING
  EARNINGS
  NEWS
}

model Event {
  id          String    @id @default(cuid())
  portfolioId String
  ticker      String
  type        EventType
  eventTime   DateTime
  title       String
  url         String
  source      String
  payloadJson Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  impacts     EventImpact[]
  reportItems DetectiveReportItem[]

  @@index([portfolioId, ticker, eventTime])
  @@index([type, eventTime])
  @@unique([portfolioId, ticker, type, eventTime, title])
}

model EventImpact {
  id           String   @id @default(cuid())
  eventId      String
  benchmark    String
  post1dAbRet  Float?
  post3dAbRet  Float?
  post5dAbRet  Float?
  computedAt   DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@unique([eventId, benchmark])
}

model DetectiveReport {
  id          String               @id @default(cuid())
  portfolioId String
  createdAt   DateTime             @default(now())
  analyzeDate DateTime
  benchmark   String
  summaryJson Json
  portfolio   Portfolio            @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  items       DetectiveReportItem[]

  @@index([portfolioId, createdAt])
}

model DetectiveReportItem {
  id              String          @id @default(cuid())
  reportId         String
  ticker          String
  eventId         String
  score           Float
  explanationJson Json
  report          DetectiveReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([reportId, score])
  @@index([eventId])
}

enum BacktestFrequency {
  WEEKLY
  MONTHLY
}

enum BacktestStrategy {
  BUY_HOLD
  RISK_PARITY
  MINVAR_QP
}

model BacktestRun {
  id          String            @id @default(cuid())
  portfolioId String
  createdAt   DateTime          @default(now())
  startDate   DateTime
  endDate     DateTime
  benchmark   String
  frequency   BacktestFrequency
  strategy    BacktestStrategy
  paramsJson  Json
  metricsJson Json
  seriesJson  Json
  weightsJson Json
  portfolio   Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
}
